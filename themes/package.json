{
  "name": "anorak-themes",
  "displayName": "Anorak Themes",
  "description": "A collection of 18 thoughtfully designed VS Code theme packs, each with light and dark variants (36 themes total), with matching editor fonts.",
  "version": "1.0.0",
  "publisher": "calebsharp",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "minimal",
    "light",
    "dark",
    "anorak"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
